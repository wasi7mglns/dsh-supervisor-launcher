{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-supervisor",
  "version": "0.1.0",
  "identifier": "dev.bowen.dsh-supervisor",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dsh-supervisor — DSH 生命周期监管",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "url": "bootstrap.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": [
      "../src-tauri/icons"
    ]
  }
}
